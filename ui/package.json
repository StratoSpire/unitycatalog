{
  "name": "unitycatalog-ui",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "type": "module",
  "dependencies": {
    "@ant-design/icons": "5.3.7",
    "@tanstack/react-query": "5.50.1",
    "antd": "5.19.1",
    "axios": "1.7.4",
    "oidc-client-ts": "3.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.24.1",
    "typescript": "5.6.2"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "format": "prettier --write 'src/**/*.{js,ts,jsx,tsx,json,html}'",
    "test:format": "prettier --check 'src/**/*.{js,ts,jsx,tsx,json,html}'",
    "generate": "bun run generate:catalog && bun run generate:control",
    "clean-bun-lock": "bun run scripts/clean-bun-lock.ts",
    "generate:catalog": "bunx openapi-typescript --enum ../api/all.yaml -o src/types/api/catalog.gen.ts",
    "generate:control": "bunx openapi-typescript --enum ../api/control.yaml -o src/types/api/control.gen.ts"
  },
  "devDependencies": {
    "@types/node": "20.17.6",
    "@types/react": "18.3.4",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.3.4",
    "prettier": "3.3.3",
    "vite": "6.0.3"
  }
}
